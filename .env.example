# ─── MCP Server ───────────────────────────────────────────────────────────────
# Token secreto para autenticar el servidor MCP.
# Debe ir en Claude → Settings → Custom MCP servers → Authorization: Bearer <valor>
MCP_AUTH_TOKEN=

# ─── Internal API ─────────────────────────────────────────────────────────────
# Secreto compartido entre las tools TypeScript y los endpoints Python de Garmin.
# Impide que /api/garmin/* sea invocable desde fuera sin este secreto.
INTERNAL_API_SECRET=

# ─── Garmin Connect ───────────────────────────────────────────────────────────
# Credenciales de tu cuenta Garmin Connect.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Fine-grained Personal Access Token con permiso contents:read/write
# únicamente sobre el repo mcp-coach-memory. Nada más.
GITHUB_TOKEN=

# Repo de memoria en formato "usuario/repo"
MEMORY_REPO=alyusva/mcp-coach-memory

# ─── Redis (sesión Garmin) ────────────────────────────────────────────────────
# URL de Upstash Redis para almacenar el token de sesión de Garmin (~23h TTL).
# Formato: redis://default:<password>@<host>:<port>
# O con TLS: rediss://default:<password>@<host>:<port>
REDIS_URL=
