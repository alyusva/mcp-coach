# ─── Atletas (modo multiusuario) ──────────────────────────────────────────────
# Lista JSON, una entrada por persona. Ver README → "Varios atletas".
#   id               minúsculas/números/guiones
#   token            Bearer del conector de esa persona (openssl rand -hex 32)
#   pin              lo que escribe en la página de autorizar (mín. 6 caracteres)
#   memoryRepo       su repo de memoria privado "usuario/repo"
#   garminSessionKey opcional, por defecto garmin:session:<id>
#   garminEnvLogin   true solo para quien usa GARMIN_EMAIL/GARMIN_PASSWORD
# Si ATHLETES está vacío, se usa el modo antiguo de un solo atleta
# (MCP_AUTH_TOKEN + MEMORY_REPO + AUTHORIZE_PIN).
ATHLETES=

# ─── Modo un solo atleta (antiguo) ────────────────────────────────────────────
MCP_AUTH_TOKEN=
# PIN que pide la página /authorize al conectar Claude por OAuth.
AUTHORIZE_PIN=

# ─── OAuth ────────────────────────────────────────────────────────────────────
# Secreto para firmar los códigos OAuth (si falta se usa INTERNAL_API_SECRET).
OAUTH_SIGNING_SECRET=
# Hosts a los que se permite devolver el código (además de localhost).
# OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com

# ─── Internal API ─────────────────────────────────────────────────────────────
# Secreto compartido entre las tools TypeScript y los endpoints Python de Garmin.
# Impide que /api/garmin/* sea invocable desde fuera sin este secreto.
INTERNAL_API_SECRET=

# ─── Garmin Connect ───────────────────────────────────────────────────────────
# Credenciales Garmin SOLO del atleta con garminEnvLogin=true (o del modo antiguo).
# El resto de personas no guardan contraseña: usa scripts/garmin_login.py.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Clave AES-256 para cifrar las sesiones de Garmin en Redis
# (genera con: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
GARMIN_SESSION_KEY=

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Fine-grained Personal Access Token con permiso contents:read/write
# únicamente sobre los repos de memoria de los atletas. Nada más.
GITHUB_TOKEN=

# Repo de memoria en formato "usuario/repo" (solo modo antiguo)
MEMORY_REPO=

# ─── Redis (sesión Garmin) ────────────────────────────────────────────────────
# URL de Upstash Redis para almacenar el token de sesión de Garmin (~23h TTL).
# Formato: redis://default:<password>@<host>:<port>
# O con TLS: rediss://default:<password>@<host>:<port>
REDIS_URL=

# ─── Cron semanal (revisión automática cada lunes) ────────────────────────────
# Clave de Anthropic para que el cron pueda llamar a Claude.
ANTHROPIC_API_KEY=

# Secreto que Vercel envía al invocar el cron (genera con: openssl rand -hex 32).
# Configúralo también en Vercel Dashboard → Settings → Cron Job Secret.
CRON_SECRET=
